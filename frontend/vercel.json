{
	"$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://capstone-3-library-app.vercel.app/:path*"
    },
		{
      "source": "/auth/:path",
      "destination": "https://capstone-3-library-app.vercel.app/:path"
    }
  ]
}
